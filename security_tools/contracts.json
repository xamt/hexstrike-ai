{
  "testssl_scan": {
    "endpoint": "api/tools/testssl",
    "description": "使用testssl检查单个HTTPS目标的TLS配置；输出为待复核证据而非已确认漏洞",
    "parameters": {
      "target": {
        "type": "str",
        "required": true
      },
      "timeout": {
        "type": "int",
        "required": false,
        "default": 120
      },
      "max_output_bytes": {
        "type": "int",
        "required": false,
        "default": 65536
      }
    }
  },
  "whatweb_scan": {
    "endpoint": "api/tools/whatweb",
    "description": "使用WhatWeb识别单个HTTP目标指纹，aggression范围1至3；指纹需复核",
    "parameters": {
      "target": {
        "type": "str",
        "required": true
      },
      "aggression": {
        "type": "int",
        "required": false,
        "default": 1
      },
      "timeout": {
        "type": "int",
        "required": false,
        "default": 120
      },
      "max_output_bytes": {
        "type": "int",
        "required": false,
        "default": 65536
      }
    }
  },
  "jwt_tool_analyze": {
    "endpoint": "api/tools/jwt-tool",
    "description": "jwt_tool默认本地decode；scan显式对target_url发送Bearer令牌并执行-M at，不替代内置jwt_analyzer；输出可能含敏感令牌",
    "parameters": {
      "token": {
        "type": "str",
        "required": true
      },
      "mode": {
        "type": "str",
        "required": false,
        "default": "decode"
      },
      "target_url": {
        "type": "str",
        "required": false,
        "default": ""
      },
      "timeout": {
        "type": "int",
        "required": false,
        "default": 120
      },
      "max_output_bytes": {
        "type": "int",
        "required": false,
        "default": 65536
      }
    }
  },
  "trufflehog_scan": {
    "endpoint": "api/tools/trufflehog",
    "description": "扫描容器内绝对路径filesystem或HTTPS/file Git仓库；默认不联网验证凭据，verify=true显式启用；结果含敏感数据，发现不等于漏洞",
    "parameters": {
      "source": {
        "type": "str",
        "required": false,
        "default": "filesystem"
      },
      "target": {
        "type": "str",
        "required": true
      },
      "verify": {
        "type": "bool",
        "required": false,
        "default": false
      },
      "timeout": {
        "type": "int",
        "required": false,
        "default": 120
      },
      "max_output_bytes": {
        "type": "int",
        "required": false,
        "default": 65536
      }
    }
  },
  "tcpdump_capture": {
    "endpoint": "api/tools/tcpdump",
    "description": "默认read读取容器内绝对路径PCAP；capture需显式interface和count，最多10000包/120秒且需要网络抓包权限；不写PCAP文件",
    "parameters": {
      "mode": {
        "type": "str",
        "required": false,
        "default": "read"
      },
      "read_file": {
        "type": "str",
        "required": false,
        "default": ""
      },
      "interface": {
        "type": "str",
        "required": false,
        "default": ""
      },
      "count": {
        "type": "int",
        "required": false,
        "default": 100
      },
      "filter": {
        "type": "str",
        "required": false,
        "default": ""
      },
      "timeout": {
        "type": "int",
        "required": false,
        "default": 30
      },
      "max_output_bytes": {
        "type": "int",
        "required": false,
        "default": 65536
      }
    }
  }
}
