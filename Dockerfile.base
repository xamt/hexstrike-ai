# syntax=docker/dockerfile:1.7

# =============================================================================
# 1. 构建配置：只保留上游镜像、平台和软件源
# =============================================================================
# 工具版本与安装命令一起维护在 docker/install-*.sh；此处不重复声明。
# 安装成功后生成预期版本记录，最终阶段读取记录校验并生成 tool-versions.lock。
# BUILDPLATFORM/TARGETARCH 由 BuildKit 提供，不在全局重声明以免覆盖为空。
ARG KALI_BASE_IMAGE=kalilinux/kali-rolling:latest
ARG GO_BUILD_IMAGE=golang:1.25-bookworm
ARG RUST_BUILD_IMAGE=rust:1.85-bookworm
ARG NIKTO_BUILD_IMAGE=debian:bookworm-slim
ARG PYTHON_RUNTIME_IMAGE=python:3.11-slim-bookworm
ARG KALI_APT_MIRROR=https://mirrors.aliyun.com/kali
ARG KALI_APT_SUITE=kali-rolling
# Python 包默认从国内 HTTPS 镜像下载；包源属于构建配置，工具版本仍在安装脚本中。
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Go 模块与校验数据库通过国内 HTTPS 代理下载；保留官方校验数据库签名身份。
# 不自动回退境外源，避免代理异常时再次遇到 proxy.golang.org 连接中断。
ARG GOPROXY=https://goproxy.cn
ARG GOSUMDB="sum.golang.org https://goproxy.cn/sumdb/sum.golang.org"

# =============================================================================
# 2. Go 工具：构建机运行编译器，产物面向目标架构
# =============================================================================
FROM --platform=${BUILDPLATFORM} ${GO_BUILD_IMAGE} AS go-tools
ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY
ARG GOSUMDB
ENV CGO_ENABLED=0 \
    GOPROXY=${GOPROXY} \
    GOSUMDB=${GOSUMDB} \
    GOOS=${TARGETOS} \
    GOARCH=${TARGETARCH}

# 每个工具单独一层；脚本负责处理 Go 本机/交叉编译输出目录。
RUN --mount=type=bind,source=docker/install-go-tool.sh,target=/tmp/install-go-tool.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/install-go-tool.sh gau
RUN --mount=type=bind,source=docker/install-go-tool.sh,target=/tmp/install-go-tool.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/install-go-tool.sh waybackurls
RUN --mount=type=bind,source=docker/install-go-tool.sh,target=/tmp/install-go-tool.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/install-go-tool.sh anew

# =============================================================================
# 3. Rust 工具：目标架构编译 X8，编译器不进入最终镜像
# =============================================================================
FROM ${RUST_BUILD_IMAGE} AS rust-tools
ARG TARGETARCH
RUN --mount=type=bind,source=docker/install-rust-toolchain.sh,target=/tmp/install-rust-toolchain.sh \
    bash /tmp/install-rust-toolchain.sh
RUN --mount=type=bind,source=docker/install-x8.sh,target=/tmp/install-x8.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    bash /tmp/install-x8.sh

# =============================================================================
# 4. Nikto：只获取固定标签的源码，不保留 Git 元数据
# =============================================================================
FROM --platform=${BUILDPLATFORM} ${NIKTO_BUILD_IMAGE} AS nikto-source
RUN --mount=type=bind,source=docker/install-nikto-source.sh,target=/tmp/install-nikto-source.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    bash /tmp/install-nikto-source.sh

# =============================================================================
# 5. Kali 工具：按类别安装，保留独立缓存层
# =============================================================================
FROM ${PYTHON_RUNTIME_IMAGE} AS python-source
FROM ${KALI_BASE_IMAGE} AS security-packages
# 平台和源地址传入安装脚本；工具版本在对应脚本内定义。
ARG TARGETARCH
ARG KALI_APT_MIRROR
ARG KALI_APT_SUITE

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 最小 Kali 镜像尚未安装 CA 包，先借用官方 Python 镜像的信任链。
# 后续由 Kali ca-certificates 包接管，不关闭 HTTPS 或 APT 签名校验。
COPY --from=python-source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN --mount=type=bind,source=docker/install-system.sh,target=/tmp/install-system.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/install-system.sh

RUN --mount=type=bind,source=docker/install-network.sh,target=/tmp/install-network.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/install-network.sh

COPY --from=nikto-source /opt/nikto/ /opt/nikto/
COPY --from=nikto-source /opt/tool-versions.d/ /opt/hexstrike/tool-versions.d/

RUN --mount=type=bind,source=docker/install-web.sh,target=/tmp/install-web.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/install-web.sh

RUN --mount=type=bind,source=docker/install-password.sh,target=/tmp/install-password.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/install-password.sh

RUN --mount=type=bind,source=docker/install-binary.sh,target=/tmp/install-binary.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/install-binary.sh

# =============================================================================
# 6. 工具组装：复制编译产物和安装记录，准备小型字典
# =============================================================================
FROM security-packages AS security-tools
COPY --from=go-tools /out/bin/ /usr/local/bin/
COPY --from=go-tools /out/tool-versions.d/ /opt/hexstrike/tool-versions.d/
COPY --from=rust-tools /out/bin/x8 /usr/local/bin/x8
COPY --from=rust-tools /out/tool-versions.d/ /opt/hexstrike/tool-versions.d/
RUN --mount=type=bind,source=docker/prepare-tool-data.sh,target=/tmp/prepare-tool-data.sh \
    bash /tmp/prepare-tool-data.sh

# 补齐 TLS、Web 指纹、凭据泄漏及网络证据能力，原工具安装层保持不变。
RUN --mount=type=bind,source=docker/install-security-extras.sh,target=/tmp/install-security-extras.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    bash /tmp/install-security-extras.sh

# 数据库客户端独立安装层：版本与双架构摘要均在各安装脚本中维护。
# 不配置或启动数据库服务；ClickHouse common-static 是客户端必需的公共二进制。
RUN --mount=type=bind,source=docker/install-database-apt.sh,target=/tmp/install-database-apt.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    bash /tmp/install-database-apt.sh
RUN --mount=type=bind,source=docker/install-database-clickhouse.sh,target=/tmp/install-database-clickhouse.sh \
    --mount=type=bind,source=docker/install-database-deb.sh,target=/tmp/install-database-deb.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    bash /tmp/install-database-clickhouse.sh
RUN --mount=type=bind,source=docker/install-database-mongodb.sh,target=/tmp/install-database-mongodb.sh \
    --mount=type=bind,source=docker/install-database-deb.sh,target=/tmp/install-database-deb.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    bash /tmp/install-database-mongodb.sh

# =============================================================================
# 7. Python 运行时：Volatility3 与 JWT-Tool 分别使用独立虚拟环境
# =============================================================================
FROM python-source AS python-runtime
ARG PIP_INDEX_URL
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
RUN --mount=type=bind,source=docker/install-python-runtime.sh,target=/tmp/install-python-runtime.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    bash /tmp/install-python-runtime.sh
RUN --mount=type=bind,source=docker/install-jwt-tool.sh,target=/tmp/install-jwt-tool.sh \
    --mount=type=bind,source=docker/record-tool-version.sh,target=/tmp/record-tool-version.sh \
    bash /tmp/install-jwt-tool.sh

# =============================================================================
# 8. 最终基础镜像：接入 Python、校验全部工具，默认进入 Bash
# =============================================================================
FROM security-tools AS base
ARG TARGETARCH
COPY --from=python-runtime /usr/local/ /usr/local/
COPY --from=python-runtime /opt/volatility3-venv/ /opt/volatility3-venv/
COPY --from=python-runtime /opt/jwt-tool-venv/ /opt/jwt-tool-venv/
COPY --from=python-runtime /opt/jwt-tool/ /opt/jwt-tool/
COPY --from=python-runtime /opt/tool-versions.d/ /opt/hexstrike/tool-versions.d/
RUN --mount=type=bind,source=docker/finalize-base.sh,target=/tmp/finalize-base.sh \
    bash /tmp/finalize-base.sh
RUN --mount=type=bind,source=docker/verify-base.sh,target=/tmp/verify-base.sh \
    --mount=type=bind,source=docker/verify-tool-versions.py,target=/tmp/verify-tool-versions.py \
    bash /tmp/verify-base.sh

# 不安装项目依赖、不复制项目代码、不开放服务端口。
WORKDIR /opt/hexstrike
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
