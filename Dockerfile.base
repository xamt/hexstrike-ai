# syntax=docker/dockerfile:1.7

# =============================================================================
# 1. 构建配置：只保留上游镜像、平台和软件源
# =============================================================================
# 工具版本与安装命令一起维护在 docker/tools/<类别>/<安装方式>.sh；此处不重复声明。
# 安装成功后生成预期版本记录，最终阶段读取记录校验并生成 tool-versions.lock。
# BUILDPLATFORM/TARGETARCH 由 BuildKit 提供，不在全局重声明以免覆盖为空。
ARG KALI_BASE_IMAGE=kalilinux/kali-rolling:latest
ARG GO_BUILD_IMAGE=golang:1.25-bookworm
ARG RUST_BUILD_IMAGE=rust:1.85-bookworm
ARG NIKTO_BUILD_IMAGE=debian:bookworm-slim
ARG PYTHON_RUNTIME_IMAGE=python:3.11-slim-bookworm
# 固定双架构索引摘要：旧取证接口需要真正的 Python 2，编译器不进入最终镜像。
ARG LEGACY_PYTHON_RUNTIME_IMAGE=python:2.7.18-buster@sha256:d8fac68ebdc45b8d66d53f1ed6c1532da81109a8f5532a6ca0c951ed31107d70
ARG KALI_APT_MIRROR=https://mirrors.aliyun.com/kali
ARG KALI_APT_SUITE=kali-rolling
# Python 包默认从国内 HTTPS 镜像下载；包源属于构建配置，工具版本仍在安装脚本中。
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Go 模块与校验数据库通过国内 HTTPS 代理下载；保留官方校验数据库签名身份。
# 不自动回退境外源，避免代理异常时再次遇到 proxy.golang.org 连接中断。
ARG GOPROXY=https://goproxy.cn
ARG GOSUMDB="sum.golang.org https://goproxy.cn/sumdb/sum.golang.org"

# =============================================================================
# 2. Go 工具：构建机运行编译器，产物面向目标架构
# =============================================================================
FROM --platform=${BUILDPLATFORM} ${GO_BUILD_IMAGE} AS go-tools
ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY
ARG GOSUMDB
ENV CGO_ENABLED=0 \
    GOPROXY=${GOPROXY} \
    GOSUMDB=${GOSUMDB} \
    GOOS=${TARGETOS} \
    GOARCH=${TARGETARCH}

# 每个工具单独一层；脚本负责处理 Go 本机/交叉编译输出目录。
RUN --mount=type=bind,source=docker/tools/osint/go.sh,target=/tmp/docker/tools/osint/go.sh \
    --mount=type=bind,source=docker/lib/build-go-tool.sh,target=/tmp/docker/lib/build-go-tool.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/docker/tools/osint/go.sh gau
RUN --mount=type=bind,source=docker/tools/osint/go.sh,target=/tmp/docker/tools/osint/go.sh \
    --mount=type=bind,source=docker/lib/build-go-tool.sh,target=/tmp/docker/lib/build-go-tool.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/docker/tools/osint/go.sh waybackurls
RUN --mount=type=bind,source=docker/tools/osint/go.sh,target=/tmp/docker/tools/osint/go.sh \
    --mount=type=bind,source=docker/lib/build-go-tool.sh,target=/tmp/docker/lib/build-go-tool.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/docker/tools/osint/go.sh anew
RUN --mount=type=bind,source=docker/tools/web/go.sh,target=/tmp/docker/tools/web/go.sh \
    --mount=type=bind,source=docker/lib/build-go-tool.sh,target=/tmp/docker/lib/build-go-tool.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    bash /tmp/docker/tools/web/go.sh

# =============================================================================
# 3. Rust 工具：目标架构编译 X8，编译器不进入最终镜像
# =============================================================================
FROM ${RUST_BUILD_IMAGE} AS rust-tools
ARG TARGETARCH
RUN --mount=type=bind,source=docker/runtime/rust-toolchain.sh,target=/tmp/docker/runtime/rust-toolchain.sh \
    bash /tmp/docker/runtime/rust-toolchain.sh
RUN --mount=type=bind,source=docker/tools/web/rust.sh,target=/tmp/docker/tools/web/rust.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/web/rust.sh

# =============================================================================
# 4. Nikto：只获取固定标签的源码，不保留 Git 元数据
# =============================================================================
FROM --platform=${BUILDPLATFORM} ${NIKTO_BUILD_IMAGE} AS nikto-source
RUN --mount=type=bind,source=docker/tools/web/source.sh,target=/tmp/docker/tools/web/source.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/web/source.sh

# =============================================================================
# 5. Kali 软件包与 Ruby 工具：用途分类与安装方式分离
# =============================================================================
FROM ${PYTHON_RUNTIME_IMAGE} AS python-source
FROM ${KALI_BASE_IMAGE} AS security-packages
# 平台和源地址传入安装脚本；工具版本在对应脚本内定义。
ARG TARGETARCH
ARG KALI_APT_MIRROR
ARG KALI_APT_SUITE

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# 最小 Kali 镜像尚未安装 CA 包，先借用官方 Python 镜像的信任链。
# 后续由 Kali ca-certificates 包接管，不关闭 HTTPS 或 APT 签名校验。
COPY --from=python-source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN --mount=type=bind,source=docker/runtime/system.sh,target=/tmp/docker/runtime/system.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/runtime/system.sh

RUN --mount=type=bind,source=docker/tools/network/apt.sh,target=/tmp/docker/tools/network/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/network/apt.sh

COPY --from=nikto-source /opt/nikto/ /opt/nikto/
COPY --from=nikto-source /opt/tool-versions.d/ /opt/pentest-tools/tool-versions.d/

RUN --mount=type=bind,source=docker/tools/web/apt.sh,target=/tmp/docker/tools/web/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/web/apt.sh

RUN --mount=type=bind,source=docker/tools/web/ruby.sh,target=/tmp/docker/tools/web/ruby.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/web/ruby.sh

RUN --mount=type=bind,source=docker/tools/authentication/apt.sh,target=/tmp/docker/tools/authentication/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/authentication/apt.sh

RUN --mount=type=bind,source=docker/tools/binary/apt.sh,target=/tmp/docker/tools/binary/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/binary/apt.sh

RUN --mount=type=bind,source=docker/tools/forensics/apt.sh,target=/tmp/docker/tools/forensics/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/forensics/apt.sh

RUN --mount=type=bind,source=docker/tools/osint/apt.sh,target=/tmp/docker/tools/osint/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/osint/apt.sh

# =============================================================================
# 6. 工具组装：复制编译产物、准备小型字典、安装容器客户端
# =============================================================================
FROM security-packages AS security-tools
COPY --from=go-tools /out/bin/ /usr/local/bin/
COPY --from=go-tools /out/tool-versions.d/ /opt/pentest-tools/tool-versions.d/
COPY --from=rust-tools /out/bin/x8 /usr/local/bin/x8
COPY --from=rust-tools /out/tool-versions.d/ /opt/pentest-tools/tool-versions.d/
RUN --mount=type=bind,source=docker/assembly/prepare-tool-data.sh,target=/tmp/docker/assembly/prepare-tool-data.sh \
    bash /tmp/docker/assembly/prepare-tool-data.sh

# 通用容器环境：Docker CLI、kubectl、Helm；不安装 daemon 或专有云工具。
RUN --mount=type=bind,source=docker/tools/container/apt.sh,target=/tmp/docker/tools/container/apt.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    --mount=type=cache,id=hexstrike-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=hexstrike-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=hexstrike-external-seclists-${TARGETARCH},target=/usr/share/seclists,sharing=locked \
    bash /tmp/docker/tools/container/apt.sh

# Kube-Bench 使用官方双架构固定发布包，附带 CIS 配置，不通过不明代理获取。
RUN --mount=type=bind,source=docker/tools/container/release.sh,target=/tmp/docker/tools/container/release.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/container/release.sh

# =============================================================================
# 7. Python 3：先安装运行组件，再按类别准备各工具的隔离环境
# =============================================================================
FROM python-source AS python-runtime
ARG TARGETARCH
ARG PIP_INDEX_URL
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
RUN --mount=type=bind,source=docker/runtime/python.sh,target=/tmp/docker/runtime/python.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/runtime/python.sh

RUN --mount=type=bind,source=docker/tools/forensics/python3.sh,target=/tmp/docker/tools/forensics/python3.sh \
    --mount=type=bind,source=docker/runtime/python.sh,target=/tmp/docker/runtime/python.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/forensics/python3.sh
RUN --mount=type=bind,source=docker/tools/authentication/python.sh,target=/tmp/docker/tools/authentication/python.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/authentication/python.sh

RUN --mount=type=bind,source=docker/tools/web/python.sh,target=/tmp/docker/tools/web/python.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/web/python.sh
RUN --mount=type=bind,source=docker/compat/install-volatility3.sh,target=/tmp/docker/compat/install-volatility3.sh \
    bash /tmp/docker/compat/install-volatility3.sh

# netifaces 编译依赖只留在本构建阶段，最终镜像仅复制隔离环境与运行时。
RUN --mount=type=bind,source=docker/tools/container/python.sh,target=/tmp/docker/tools/container/python.sh \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/container/python.sh

# =============================================================================
# 8. 旧取证运行时：真实 Volatility 2，避免把 profile 接口映射至 Volatility 3
# =============================================================================
FROM ${LEGACY_PYTHON_RUNTIME_IMAGE} AS legacy-python-runtime
ARG TARGETARCH
ARG PIP_INDEX_URL
COPY --from=python-source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN --mount=type=bind,source=docker/tools/forensics/python2.sh,target=/tmp/docker/tools/forensics/python2.sh \
    --mount=type=bind,source=docker/lib/collect-python2-runtime.py,target=/tmp/docker/lib/collect-python2-runtime.py \
    --mount=type=bind,source=docker/lib/record-tool-version.sh,target=/tmp/docker/lib/record-tool-version.sh \
    bash /tmp/docker/tools/forensics/python2.sh

# =============================================================================
# 9. 最终基础镜像：接入 Python、校验全部工具，默认进入 Bash
# =============================================================================
FROM security-tools AS base
ARG TARGETARCH
ENV PATH="/opt/hexstrike-compat/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
COPY --from=python-runtime /usr/local/ /usr/local/
COPY --from=python-runtime /opt/volatility3-venv/ /opt/volatility3-venv/
COPY --from=python-runtime /opt/jwt-tool-venv/ /opt/jwt-tool-venv/
COPY --from=python-runtime /opt/jwt-tool/ /opt/jwt-tool/
COPY --from=python-runtime /opt/paramspider/ /opt/paramspider/
COPY --from=python-runtime /opt/paramspider-venv/ /opt/paramspider-venv/
COPY --from=python-runtime /opt/volatility3/ /opt/volatility3/
COPY --from=python-runtime /opt/kube-hunter-venv/ /opt/kube-hunter-venv/
COPY --from=legacy-python-runtime /out/ /
COPY --from=python-runtime /opt/tool-versions.d/ /opt/pentest-tools/tool-versions.d/
RUN --mount=type=bind,source=docker/compat/install.sh,target=/tmp/docker/compat/install.sh \
    --mount=type=bind,source=docker/compat/cli-compat.py,target=/tmp/docker/compat/cli-compat.py \
    --mount=type=bind,source=docker/compat/ExportXml.java,target=/tmp/docker/compat/ExportXml.java \
    --mount=type=bind,source=docker/compat/autorecon-compat.py,target=/tmp/docker/compat/autorecon-compat.py \
    --mount=type=bind,source=docker/compat/autorecon-plugins/hexstrike-tcp-profiles.py,target=/tmp/docker/compat/autorecon-plugins/hexstrike-tcp-profiles.py \
    --mount=type=bind,source=docker/compat/hakrawler-compat.py,target=/tmp/docker/compat/hakrawler-compat.py \
    --mount=type=bind,source=docker/compat/hakrawler_runtime.py,target=/tmp/docker/compat/hakrawler_runtime.py \
    --mount=type=bind,source=docker/compat/hakrawler_sources.py,target=/tmp/docker/compat/hakrawler_sources.py \
    --mount=type=bind,source=docker/compat/hakrawler_process.py,target=/tmp/docker/compat/hakrawler_process.py \
    --mount=type=bind,source=docker/compat/nuclei-compat.py,target=/tmp/docker/compat/nuclei-compat.py \
    bash /tmp/docker/compat/install.sh
RUN --mount=type=bind,source=docker/assembly/finalize-base.sh,target=/tmp/docker/assembly/finalize-base.sh \
    bash /tmp/docker/assembly/finalize-base.sh
RUN --mount=type=bind,source=docker/verify/base.sh,target=/tmp/docker/verify/base.sh \
    --mount=type=bind,source=docker/verify/verify-tool-versions.py,target=/tmp/docker/verify/verify-tool-versions.py \
    bash /tmp/docker/verify/base.sh

# 不安装项目依赖、不复制项目代码、不开放服务端口。
WORKDIR /opt/pentest-tools
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
