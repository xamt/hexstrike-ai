{
  "mysql_query": {
    "endpoint": "api/tools/mysql",
    "description": "MySQL/MariaDB 受保护SQL：允许查询、INSERT和UPDATE，删除/DDL/脚本返回 operation_not_allowed",
    "parameters": {
      "host": {
        "type": "str",
        "required": true
      },
      "port": {
        "type": "int",
        "required": false,
        "default": 3306
      },
      "username": {
        "type": "str",
        "required": false,
        "default": "root"
      },
      "password": {
        "type": "str",
        "required": false,
        "default": ""
      },
      "database": {
        "type": "str",
        "required": false,
        "default": ""
      },
      "query": {
        "type": "str",
        "required": true
      },
      "timeout": {
        "type": "int",
        "required": false,
        "default": 30
      },
      "max_output_bytes": {
        "type": "int",
        "required": false,
        "default": 65536
      }
    }
  },
